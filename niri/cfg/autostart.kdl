// ────────────── Startup Applications ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Miscellaneous#spawn-sh-at-startup

spawn-sh-at-startup "gnome-keyring-daemon --start --components=secrets"
spawn-sh-at-startup "/usr/libexec/hyprpolkitagent"
spawn-sh-at-startup "dbus-update-activation-environment --all"
spawn-sh-at-startup "sleep 1 && dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP"
spawn-sh-at-startup "systemctl start --user ximper-unified-theme-switcher.service"


spawn-sh-at-startup "qs -c noctalia-shell"
//spawn-sh-at-startup "waybar"
//spawn-sh-at-startup "swaync"
spawn-sh-at-startup "wl-clip-persist --clipboard regular --reconnect-tries 0"

spawn-sh-at-startup "wm-xdg-autostart"